<?xml version="1.0"?>
<package format="3">

    <name>autonomy_bringup</name>
    <version>0.1.0</version>

    <description>
        Main bringup package for the autonomous robot demo.
    </description>

    <maintainer email="ramongavrilov@email.com">
        Roman Gavrilov
    </maintainer>

    <license>Proprietary</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <exec_depend>autonomy_description</exec_depend>
    <exec_depend>autonomy_gazebo</exec_depend>
    <exec_depend>autonomy_navigation</exec_depend>

    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>

</package>